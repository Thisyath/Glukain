# Database
DATABASE_URL="mysql://root:@localhost:3306/glukain"

# JWT
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_ACCESS_TTL=900

# Refresh Token
REFRESH_TTL_DAYS=7

# Frontend
FRONTEND_ORIGIN="http://localhost:5173"

# AI API (Gemini free tier)
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Email (Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Midtrans Sandbox
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false

# App
PORT=3001
NODE_ENV=development
